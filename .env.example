# Copy to .env and fill in only what you need. Never commit real tokens.

# Optional work integrations (all off by default)
KESH_SLACK_BOT_TOKEN=
KESH_SLACK_USER_TOKEN=
KESH_JIRA_BASE_URL=https://YOUR_SITE.atlassian.net
KESH_JIRA_EMAIL=
KESH_JIRA_API_TOKEN=
KESH_CONFLUENCE_BASE_URL=https://YOUR_SITE.atlassian.net/wiki
KESH_CONFLUENCE_EMAIL=
KESH_CONFLUENCE_API_TOKEN=
KESH_GMAIL_CLIENT_ID=
KESH_GMAIL_CLIENT_SECRET=
KESH_GMAIL_REFRESH_TOKEN=
KESH_GITHUB_TOKEN=

# Optional web search override
KESH_WEB_SEARCH_PROVIDER=duckduckgo
KESH_WEB_SEARCH_API_KEY=

# Debug UI / logs
KESH_DEBUG=false
